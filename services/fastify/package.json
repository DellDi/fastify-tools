{
  "name": "fastify-service",
  "author": "DellDi",
  "license": "ISC",
  "version": "1.0.0",
  "description": "This project was bootstrapped with Fastify-CLI.",
  "type": "module",
  "main": "api/index.js",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "node ../../scripts/with-env.mjs fastify pnpm run build && tsc -p test/tsconfig.json && FASTIFY_AUTOLOAD_TYPESCRIPT=1 node --test --experimental-test-coverage --loader ts-node/esm test/**/*.ts",
    "dev": "pnpm run build && concurrently -k -p \"[{name}]\" -n \"TypeScript,AliasWatch,App\" -c \"yellow.bold,magenta.bold,cyan.bold\" \"pnpm run watch:ts\" \"pnpm run watch:alias\" \"pnpm run dev:start\"",
    "build": "node ../../scripts/with-env.mjs fastify tsc && tsc-alias",
    "watch:ts": "tsc -w",
    "watch:alias": "tsc-alias -w",
    "start": "pnpm run build && node ../../scripts/with-env.mjs fastify node ./api/index.js",
    "dev:start": "node ../../scripts/with-env.mjs fastify fastify start --ignore-watch=.ts$ -w -l info -P ./api/app.js",
    "debug": "node ../../scripts/with-env.mjs fastify fastify start --debug --ignore-watch=.ts$ -w -l info -P ./api/app.js",
    "pm2:start:config": "pm2 start ecosystem.config.cjs",
    "pm2:stop:config": "pm2 stop ecosystem.config.cjs",
    "c8:html": "node node_modules/c8/bin/c8.js -r html node api/index.js",
    "prisma:generate": "node ../../scripts/with-env.mjs fastify prisma generate",
    "prisma:seed": "node ../../scripts/with-env.mjs fastify prisma db seed",
    "prisma:migrate:dev": "node ../../scripts/with-env.mjs fastify prisma migrate dev",
    "prisma:migrate:deploy": "node ../../scripts/with-env.mjs fastify prisma migrate deploy",
    "prisma:migrate:reset": "node ../../scripts/with-env.mjs fastify prisma migrate reset --force",
    "prisma:studio": "node ../../scripts/with-env.mjs fastify prisma studio"
  },
  "dependencies": {
    "@fastify/auth": "^5.0.2",
    "@fastify/autoload": "^6.3.0",
    "@fastify/bearer-auth": "^10.1.1",
    "@fastify/cors": "^11.0.1",
    "@fastify/env": "^5.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/one-line-logger": "^2.0.2",
    "@fastify/postgres": "^6.0.2",
    "@fastify/sensible": "^6.0.3",
    "@fastify/static": "^8.1.1",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2",
    "@fastify/type-provider-typebox": "^5.1.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@prisma/client": "^6.6.0",
    "@scalar/fastify-api-reference": "^1.28.12",
    "@sinclair/typebox": "^0.34.33",
    "cheerio": "^1.0.0",
    "close-with-grace": "^2.2.0",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.2",
    "fastify-cli": "^7.4.0",
    "fastify-plugin": "^5.0.1",
    "fflate": "^0.8.3",
    "lru-cache": "^11.1.0",
    "nodemailer": "^6.10.0",
    "pg": "^8.14.1",
    "undici": "^7.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/lru-cache": "^7.10.10",
    "@types/node": "^20.17.30",
    "@types/nodemailer": "^6.4.17",
    "c8": "^10.1.3",
    "fastify-tsconfig": "^3.0.0",
    "prisma": "^6.6.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.19.3",
    "typescript": "~5.8.3"
  }
}
