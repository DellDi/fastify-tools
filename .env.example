# 根目录统一配置：所有子项目和 Docker Compose 共用本文件。
# 首次使用时复制为 .env 并填写；已有系统环境变量优先于 .env。
# 以 NEXT_PUBLIC_ 开头的值会打包到浏览器，修改后需重新构建前端，不能存放服务端密钥。

# ==================== 共享：运行环境与 Docker Compose ====================
# 本机单独运行子项目时的 Node.js 环境，通常使用 development。
NODE_ENV=development
# Docker 容器中的 Node.js 环境，生产部署通常使用 production。
DOCKER_NODE_ENV=production
# Docker 构建时 npm、pnpm 和 Corepack 使用的软件包镜像。
NPM_REGISTRY=https://registry.npmmirror.com
# Prisma 引擎下载镜像；适用于客户端生成和迁移引擎下载。
PRISMA_ENGINES_MIRROR=https://cdn.npmmirror.com/binaries/prisma
# PostgreSQL 容器首次初始化时创建的数据库用户名。
POSTGRES_USER=postgres
# PostgreSQL 容器首次初始化时设置的数据库密码。
POSTGRES_PASSWORD=postgres
# PostgreSQL 容器首次初始化时创建的默认数据库名。
POSTGRES_DB=postgres
# PostgreSQL 容器映射到宿主机的端口。
EXPORT_PG_PORT=5433
# Fastify 容器映射到宿主机的端口，容器内部端口为 3100。
EXPORT_FASTIFY_PORT=4000
# Next.js 容器映射到宿主机的端口，容器内部端口为 3200。
EXPORT_NEXT_PORT=4001

# ==================== Fastify：后端 API ====================
# 本机单独运行 Fastify 或执行其 Prisma 命令时使用的数据库地址。
FASTIFY_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/fastify_db
# 本机单独运行 Fastify 时监听的端口；Docker 内固定使用 3100。
PORT=3000
# Fastify 收到退出信号后的优雅关闭等待时间，单位毫秒。
FASTIFY_CLOSE_GRACE_DELAY=500
# Fastify 路由前缀；本机可留空，使用反向代理时可填写 /fastify。Docker 留空时默认 /fastify。
API_PREFIX=
# Fastify 受 Bearer Token 保护接口的认证令牌。
BEARER_TOKEN=

# ---------- Jira（Fastify 与 Next.js 共用账号） ----------
# Jira 登录用户名。
JIRA_USERNAME=
# Jira 登录密码。
JIRA_PASSWORD=
# Jira 服务的根地址，不含具体 REST 接口路径。
JIRA_BASE_URL=
# Jira 前置代理需要的 Authorization 头完整值，例如 Basic 加空格及编码后的凭据；firecrawl 脚本抓取内网站点复用同一凭据。
JIRA_PROXY_AUTH=
# 创建或更新工单时使用的默认经办人用户名。
JIRA_ASSIGNEE_USER=
# 未指定项目时使用的 Jira 项目标识，例如 NLC。
JIRA_DEFAULT_PROJECT=
# 未指定工单类型时使用的 Jira 问题类型 ID。
JIRA_DEFAULT_ISSUE_TYPE=
# 未指定模块时使用的 Jira 组件 ID。
JIRA_DEFAULT_COMPONENT=
# 未指定优先级时使用的 Jira 优先级 ID。
JIRA_DEFAULT_PRIORITY=

# ---------- 邮件服务 ----------
# SMTP 邮件服务器地址。
SMTP_HOST=smtp.qq.com
# SMTP 服务器端口；QQ 邮箱的 STARTTLS 端口通常为 587。
SMTP_PORT=587
# SMTP 登录账号，也作为项目发送邮件时的发件人。
SMTP_USER=
# SMTP 登录密码或邮箱服务提供的授权码。
SMTP_PASS=
# 是否从连接开始使用 TLS；587/STARTTLS 通常为 false。
SMTP_SECURE=false

# ---------- 大模型（Fastify 与 tools 脚本共用） ----------
# 调用大模型时使用的 API Key，例如 DeepSeek、DashScope。
LLM_API_KEY=
# Fastify 实际发送 POST 请求的完整聊天接口地址，需包含 /chat/completions；tools 脚本会自动去掉该后缀作为 SDK baseURL。
LLM_BASE_URL=https://api.deepseek.com/chat/completions
# 请求大模型时使用的模型名称。
LLM_MODEL=deepseek-flash

# ---------- Pages 静态站点部署 ----------
# 部署接口写入的站点目录（容器内固定 /srv/pages-sites，已绑定挂载到宿主机同名目录）。
# 站点对外访问的泛域名后缀，URL 形如 https://<slug>.<PAGES_BASE_DOMAIN>。
PAGES_BASE_DOMAIN=pages.delldiagi.top

# ==================== Next.js：前端与用户认证 ====================
# 本机单独运行 Next.js 或执行其 Prisma 命令时使用的数据库地址。
NEXT_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/shadcn_next
# Next.js 应用的 URL 路径前缀；本机可留空，Docker 留空时默认 /next。
NEXT_PUBLIC_BASE_PATH=
# 本机开发时浏览器访问 Fastify 的基础地址。
NEXT_PUBLIC_API_URL=http://localhost:3000
# Docker 构建前端时写入浏览器代码的 Fastify 地址或反向代理路径。
DOCKER_NEXT_PUBLIC_API_URL=/fastify
# 本机运行 Next.js 时，服务端访问 Fastify 的基础地址。
SERVER_FASTIFY_API=http://localhost:3000
# Next.js 容器访问 Fastify 的 Docker 网络内地址，需包含实际 API 前缀。
DOCKER_SERVER_FASTIFY_API=http://fastify:3100/fastify
# 站点对外的基础地址，用于邮件验证、注册和找回密码链接。
SITE_DOMAIN_URL=http://localhost:3001
# 浏览器访问独立 FastAPI 工具服务的基础地址。
NEXT_PUBLIC_FAST_API_URL=http://localhost:8000
# 浏览器访问 FastAPI 工具服务时携带的 Bearer Token；此值对浏览器用户可见。
NEXT_PUBLIC_FAST_API_KEY=
# 用户登录 JWT 的签名密钥，应使用独立、随机且不公开的长字符串。
JWT_SECRET=
# 初始化测试用户及注册默认密码；已有用户的密码不会因修改此项自动更新。
INITIAL_USER_PASSWORD=
# 初始化超级管理员密码；已有管理员的密码不会因修改此项自动更新。
INITIAL_SUPER_PASSWORD=

# ==================== services/tools：独立工具脚本 ====================
# Firecrawl 服务的 API Key。
FIRECRAWL_API_KEY=
# 被抓取站点登录表单使用的用户名。
FIRECRAWL_LOGIN_USERNAME=
# 被抓取站点登录表单使用的密码。
FIRECRAWL_LOGIN_PASSWORD=
# Firecrawl 工具需要抓取的目标页面地址。
FIRECRAWL_URL=
